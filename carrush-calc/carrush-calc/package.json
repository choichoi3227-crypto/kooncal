{
  "name": "carrush-goon-calc",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply carrush-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply carrush-db --local",
    "preview": "astro build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}