---
import Base from '../layouts/Base.astro';
import { getPoints, ROOM_NAME } from '../lib/auth';
const env = Astro.locals.runtime.env;
const points = await getPoints(env);
const { results: recent } = await env.DB
  .prepare('SELECT a_name,b_name,a_score,b_score,author,created_at FROM matches ORDER BY created_at DESC LIMIT 10').all<any>();
const logged = !!Astro.locals.sess;
const title = '카러플 군 계산기 - 군표·군체크 · 엘칭방';
const desc = '카트라이더 러쉬플러스(카러플) 군표를 순위만 입력하면 즉시 계산하고, 엘칭방 군체크까지 한 번에. 루칭방·떼칭방처럼 클럽 군전 점수를 빠르게 확인하세요.';
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: '카러플 군 계산기', url: Astro.site?.href, applicationCategory: 'GameApplication', operatingSystem: 'Any', inLanguage: 'ko', description: desc, offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: '카러플 군표는 어떻게 계산하나요?', acceptedAnswer: { '@type': 'Answer', text: `각 군 4명의 순위에 해당하는 점수를 합산합니다. 기본 점수표: ${points.map((p, i) => `${i + 1}등 ${p}점`).join(', ')}.` } },
    { '@type': 'Question', name: '엘칭방이 무엇인가요?', acceptedAnswer: { '@type': 'Answer', text: '루칭방, 떼칭방처럼 클럽 이름을 딴 군전 방으로, 엘리트 클럽의 군체크와 군표를 모아 보는 공간입니다.' } },
  ] },
];
---
<Base {title} {desc} {ld}>
  <h1>카러플 군 계산기</h1>
  <p class="mut">순위만 고르면 군표가 바로 계산됩니다. 점수표는 관리자가 관리하며 현재 기준으로 표시됩니다.</p>

  <section class="card" id="calc" data-points={JSON.stringify(points)} aria-label="군표 계산기">
    <div class="grid">
      {[['a', ROOM_NAME, 'var(--b)'], ['b', '상대군', 'var(--r)']].map(([k, n, c]) => (
        <div>
          <input id={`${k}Name`} value={n} maxlength="20" aria-label={`${k} 군 이름`} style={`border-color:${c};width:100%;font-weight:700`} />
          {[1, 2, 3, 4].map((i) => (
            <div class="row"><label for={`${k}${i}`}>{i}번</label>
              <select id={`${k}${i}`} data-t={k}><option value="">순위</option>{[1,2,3,4,5,6,7,8].map((r) => <option value={r}>{r}등</option>)}</select>
              <span class="mut" id={`${k}${i}p`}></span></div>
          ))}
        </div>
      ))}
    </div>
    <p id="res" role="status" style="font-size:1.4rem;font-weight:800;margin:14px 0 4px">순위를 입력하세요</p>
    <p id="warn" class="mut" style="color:var(--r)"></p>
    <button id="save" class:list={[!logged && 'g']} disabled={!logged}>{logged ? '군표 저장' : '저장은 로그인 후 가능'}</button>
    <button class="g" id="reset" type="button">초기화</button> <button class="g" id="copy" type="button">결과 복사</button>
  </section>

  <h2>점수표</h2>
  <div class="card" style="overflow-x:auto"><table><thead><tr>{points.map((_, i) => <th>{i + 1}등</th>)}</tr></thead><tbody><tr>{points.map((p) => <td>{p}</td>)}</tr></tbody></table></div>

  <h2>최근 저장된 군표</h2>
  <div class="card">
    {recent.length === 0 ? <p class="mut">아직 저장된 군표가 없습니다. 계산 후 저장해 보세요.</p> :
      <table><tbody>{recent.map((m) => (
        <tr><td>{m.a_name} <b>{m.a_score}</b> : <b>{m.b_score}</b> {m.b_name}</td><td class="mut">{m.author}</td><td class="mut"><time datetime={new Date(m.created_at).toISOString()}>{new Date(m.created_at).toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' })}</time></td></tr>
      ))}</tbody></table>}
  </div>

  <h2>자주 묻는 질문</h2>
  <details class="card"><summary>카러플 군표는 어떻게 계산하나요?</summary><p>각 군 4명의 순위를 점수표에 대입해 합산하고, 점수가 높은 군이 승리합니다.</p></details>
  <details class="card"><summary>엘칭방이 뭔가요?</summary><p>루칭방, 떼칭방처럼 클럽 이름을 딴 군전 방입니다. 엘리트 클럽의 방이라 엘칭방입니다. <a href="/room">군체크 바로가기</a></p></details>

  <script>
    const el = document.getElementById('calc')!;
    const P: number[] = JSON.parse(el.dataset.points!);
    const $ = (id: string) => document.getElementById(id) as HTMLSelectElement;
    const get = (t: string) => [1,2,3,4].map(i => +$(`${t}${i}`).value).filter(Boolean);
    function calc() {
      const a = get('a'), b = get('b'), all = [...a, ...b];
      for (const t of ['a','b']) for (let i=1;i<=4;i++){const v=+$(`${t}${i}`).value; document.getElementById(`${t}${i}p`)!.textContent = v ? `+${P[v-1]}` : ''}
      const sa = a.reduce((s,n)=>s+P[n-1],0), sb = b.reduce((s,n)=>s+P[n-1],0);
      const an = (document.getElementById('aName') as HTMLInputElement).value, bn = (document.getElementById('bName') as HTMLInputElement).value;
      document.getElementById('warn')!.textContent = new Set(all).size !== all.length ? '같은 순위가 중복되었습니다.' : '';
      document.getElementById('res')!.textContent = all.length ? `${an} ${sa} : ${sb} ${bn} — ${sa===sb?'무승부':(sa>sb?an:bn)+' 승 ('+Math.abs(sa-sb)+'점 차)'}` : '순위를 입력하세요';
    }
    for (const k of ['aName','bName']) { try { const v = localStorage.getItem(k); if (v) (document.getElementById(k) as HTMLInputElement).value = v; } catch {} }
    el.addEventListener('input', (e) => { const t = e.target as HTMLInputElement; if (t.id.endsWith('Name')) try { localStorage.setItem(t.id, t.value); } catch {} calc(); });
    document.getElementById('copy')!.onclick = async (e) => { const b = e.currentTarget as HTMLButtonElement; await navigator.clipboard?.writeText(document.getElementById('res')!.textContent!); b.textContent = '복사됨'; setTimeout(() => b.textContent = '결과 복사', 1200); };
    document.getElementById('reset')!.onclick = () => { el.querySelectorAll('select').forEach(s => (s as HTMLSelectElement).value=''); calc(); };
    document.getElementById('save')!.onclick = async () => {
      const r = await fetch('/api/scores', { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({ a:get('a'), b:get('b'), aName:(document.getElementById('aName') as HTMLInputElement).value, bName:(document.getElementById('bName') as HTMLInputElement).value }) });
      if (r.ok) location.reload(); else alert((await r.json()).error);
    };
  </script>
</Base>
