---
import Base from '../layouts/Base.astro';
import { getPoints } from '../lib/auth';
if (Astro.locals.sess?.role !== 'admin') return Astro.redirect('/login');
const env = Astro.locals.runtime.env;
const points = await getPoints(env);
const { results: users } = await env.DB.prepare('SELECT id, created_at FROM users ORDER BY created_at DESC LIMIT 100').all<any>();
const { results: matches } = await env.DB.prepare('SELECT id,a_name,b_name,a_score,b_score,author FROM matches ORDER BY created_at DESC LIMIT 30').all<any>();
---
<Base title="관리자 - 카러플 군 계산기" desc="관리자 페이지" path="/admin" noindex>
  <h1>관리자</h1>
  <h2>군표 점수표</h2>
  <div class="card"><div style="display:flex;gap:6px;flex-wrap:wrap" id="pts">
    {points.map((p, i) => <label class="mut">{i+1}등<br /><input type="number" min="0" max="100" value={p} style="width:64px" /></label>)}</div>
    <p><button id="savePts">점수표 저장</button> <span id="msg" class="mut"></span></p></div>
  <h2>저장된 군표</h2>
  <div class="card"><table><tbody>{matches.map((m) => <tr><td>{m.a_name} {m.a_score} : {m.b_score} {m.b_name}</td><td class="mut">{m.author}</td><td><button class="g" data-del={m.id}>삭제</button></td></tr>)}</tbody></table></div>
  <h2>회원 ({users.length})</h2>
  <div class="card">{users.length === 0 ? <span class="mut">아직 회원이 없습니다.</span> : users.map((u) => <span class="chip">{u.id} <button class="g x" data-user={u.id} aria-label={`${u.id} 삭제`}>×</button></span>)}</div>
  <script>
    document.getElementById('savePts')!.onclick = async () => {
      const points = [...document.querySelectorAll<HTMLInputElement>('#pts input')].map(i => +i.value);
      const r = await fetch('/api/admin', { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({ points }) });
      document.getElementById('msg')!.textContent = r.ok ? '저장됨' : (await r.json()).error;
    };
    document.querySelectorAll<HTMLButtonElement>('[data-user]').forEach(b => b.onclick = async () => {
      if (!confirm(b.dataset.user + ' 회원을 삭제할까요?')) return;
      await fetch('/api/admin', { method:'POST', headers:{'content-type':'application/json'}, body: JSON.stringify({ deleteUser: b.dataset.user }) }); location.reload();
    });
    document.querySelectorAll<HTMLButtonElement>('[data-del]').forEach(b => b.onclick = async () => {
      if (!confirm('이 군표를 삭제할까요?')) return;
      await fetch('/api/scores', { method:'DELETE', headers:{'content-type':'application/json'}, body: JSON.stringify({ id: +b.dataset.del! }) }); location.reload();
    });
  </script>
</Base>
